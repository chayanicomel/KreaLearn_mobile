<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow_soft"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".TabSelesaiFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Kelas Selesai"
        android:textColor="@color/green_deep"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_regular"
        android:lineSpacingExtra="8dp"
        android:text="Dasar Desain Poster untuk Pemula (100%)\nBaking Roti Sourdough (100%)"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

</LinearLayout>